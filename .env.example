# Public site origin. Used for metadataBase, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Lead capture
# ============================================================
# Demo-request submissions are inserted into `medkong.leads` in the shared
# AKOS Toolkit ("arsenal") Supabase project — see
# supabase/migrations/0001_medkong_schema.sql.
#
# That table has RLS enabled with no policies, so the service-role key is the
# only way to write to it. SERVER-ONLY: never prefix these with NEXT_PUBLIC_.
LEADS_SUPABASE_URL=https://sgizuweopqywezpkumqt.supabase.co
LEADS_SUPABASE_SERVICE_ROLE_KEY=

# Rows are tagged with `environment` (production / preview / development) so
# local and preview submissions are easy to filter out of the real pipeline.
